# Same line endings for everyone, whatever OS they use. Normalisation happens at
# `git add` time, which is why this file exists before any code does.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary files: never diffed, never normalised.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.svg   text
*.pdf   binary
*.pptx  binary
*.docx  binary
*.xlsx  binary
*.zip   binary
*.gz    binary

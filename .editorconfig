# Same formatting in every editor (VS Code, IntelliJ and others read this file).
# Line endings match .gitattributes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,java,c,cpp,h,hpp}]
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false
